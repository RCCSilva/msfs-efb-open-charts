*.pdf
*.zip
*.7z
/core/data*/
**/library/
**/inbox/
**/tiles/

# ---- Build outputs ------------------------------------------------------------
/build/
/dist/
*.exe
*.dll
*.test
*.out
*.prof
coverage*

# ---- Logs, temporary and local files ------------------------------------------
*.log
*.tmp
*.bak
*.user
.env
.env.*
viewer-state.json

# ---- Go workspace (local only) ------------------------------------------------
go.work
go.work.sum

# ---- Prototype and local dev projects (kept on disk, not part of the product) -
/server/
/charts/
/efb-project/
node_modules/
.venv/

